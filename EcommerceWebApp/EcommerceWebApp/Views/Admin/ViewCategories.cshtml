@model IEnumerable<EcommerceWebApp.Models.Category>

@{
    ViewData["Title"] = "ViewCategories";
}

<h1>ViewCategories</h1>

<p>
    <a asp-action="AddCategory">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.category_name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.category_name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.category_id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.category_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
