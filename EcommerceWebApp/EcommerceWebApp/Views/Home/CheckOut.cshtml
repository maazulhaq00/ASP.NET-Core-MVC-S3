@model Order
@{
    ViewData["Title"] = "Check out";
    Layout = "~/Views/Shared/_LayoutWeb.cshtml";
}


<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Check Out</h4>
                    <div class="breadcrumb__links">
                        <a asp-action="Index">Home</a>
                        <a asp-action="Shop">Shop</a>
                        <span>Check Out</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Checkout Section Begin -->
<section class="checkout spad">
    <div class="container">
        <div class="checkout__form">
            <form method="post" action="PlaceOrder">

                <input type="hidden" name="cust_id" value="@ViewBag.Customer.customer_id" />
                <input type="hidden" name="order_status" value="Pending" />
                
                <div class="row">
                    <div class="col-lg-8 col-md-6">
                        <h6 class="coupon__code">
                            <span class="icon_tag_alt"></span> Have a coupon? <a href="#">
                                Click
                                here
                            </a> to enter your code
                        </h6>
                        <h6 class="checkout__title">Billing Details</h6>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Fist Name<span>*</span></p>
                                    <input asp-for="firstname" value="@ViewBag.Customer.customer_name">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Last Name<span>*</span></p>
                                    <input asp-for="lastname">
                                </div>
                            </div>
                        </div>
                        <div class="checkout__input">
                            <p>Country<span>*</span></p>
                            <input asp-for="country" value="@ViewBag.Customer.customer_country">
                        </div>
                        <div class="checkout__input">
                            <p>Address<span>*</span></p>
                            <input asp-for="address" value="@ViewBag.Customer.customer_address" placeholder="Address" class="checkout__input__add">
                        </div>
                        <div class="checkout__input">
                            <p>Town/City<span>*</span></p>
                            <input asp-for="city" value="@ViewBag.Customer.customer_city">
                        </div>
                        <div class="checkout__input">
                            <p>Country/State<span>*</span></p>
                            <input asp-for="state">
                        </div>
                        <div class="checkout__input">
                            <p>Postcode / ZIP<span>*</span></p>
                            <input asp-for="zip_code">
                        </div>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Phone<span>*</span></p>
                                    <input asp-for="phone" value="@ViewBag.Customer.customer_phone">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Email<span>*</span></p>
                                    <input asp-for="email" value="@ViewBag.Customer.customer_email">
                                </div>
                            </div>
                        </div>
                        

                        <div class="checkout__input">
                            <p>Order notes<span>*</span></p>
                            <input asp-for="order_note"
                                   placeholder="Notes about your order, e.g. special notes for delivery.">
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="checkout__order">
                            <h4 class="order__title">Your order</h4>
                            <div class="checkout__order__products">Product <span>Total</span></div>
                            <ul class="checkout__total__products">
                                @{
                                    int total = 0;
                                    int subtotal = 0;
                                }
                                @foreach (var item in ViewBag.CartItems)
                                {
                                    subtotal = int.Parse(item.product.product_price) * item.product_quantity;
                                    total += subtotal;

                                    <li>

                                        @item.product.product_name x @item.product_quantity <span>Rs. @subtotal</span>

                                    </li>

                                }
                            </ul>
                            <ul class="checkout__total__all">
                                <li>Subtotal <span>Rs. @total</span></li>
                                <li>Total <span>Rs. @total</span></li>
                            </ul>
                            <div class="checkout__input__checkbox">
                                <label for="payment1">
                                    COD
                                    <input type="radio" name="payment_method" value="COD" id="payment1">
                                    <span class="checkmark"></span>
                                </label>                                
                                <label for="payment2">
                                    Card
                                    <input type="radio" name="payment_method" value="Card" id="payment2">
                                    <span class="checkmark"></span>
                                </label>
                            </div>

                            <button type="submit" class="site-btn">PLACE ORDER</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Checkout Section End -->