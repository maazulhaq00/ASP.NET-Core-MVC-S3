@model Customer
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_LayoutWeb.cshtml";
}

<!-- Contact Section Begin -->
<section class="contact spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="contact__text">
                    <div class="section-title">
                        <h2>Sign Up</h2>
                        <p>
                            Already Have an account <a asp-action="Login">Login</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="contact__form">
                    <form method="post">
                        <div class="row">
                            <div class="col-lg-6">
                                <input asp-for="customer_name" placeholder="Name">
                            </div>
                            <div class="col-lg-6">
                                <input asp-for="customer_phone" placeholder="Phone">
                            </div>
                            <div class="col-lg-6">
                                <input asp-for="customer_email" placeholder="Email">
                            </div>
                            <div class="col-lg-6">
                                <input type="password" asp-for="customer_password" placeholder="Password">
                            </div>

                            <div class="col-lg-6">
                                <input asp-for="customer_gender" placeholder="Gender">
                            </div>
                            <div class="col-lg-6">
                                <input asp-for="customer_country" placeholder="Country">
                            </div>
                            <div class="col-lg-6">
                                <input asp-for="customer_city" placeholder="City">
                            </div>
                            <div class="col-lg-6">
                                <input asp-for="customer_address" placeholder="Address">
                            </div>
                            <div class="col-lg-12">
                            
                                <button type="submit" class="site-btn">Sign Up</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->