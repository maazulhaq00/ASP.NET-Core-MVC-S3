@model Customer
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_LayoutWeb.cshtml";
}

<!-- Contact Section Begin -->
<section class="contact spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6">
                <div class="contact__text">
                    <div class="section-title">
                        <h2>Login</h2>
                        <p>
                            Don't Have an account <a asp-action="SignUp">Sign Up</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-6">
                <div class="contact__form">
                    <form method="post">
                        <div class="row">
                            <div class="col-lg-6">
                                <input asp-for="customer_email" placeholder="Email">
                            </div>
                            <div class="col-lg-6">
                                <input type="password" asp-for="customer_password" placeholder="Password">
                            </div>

                           
                            <div class="col-lg-12">

                                <button type="submit" class="site-btn">Login</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Contact Section End -->